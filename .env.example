# TLC — environment variables
# Copy to .env.local for local dev; set in Vercel dashboard for prod.

# ── Required ────────────────────────────────────────────────────────────

# Gemma 4 via Google AI Studio — https://aistudio.google.com/apikey
# Free-tier covers ~1500 req/day; one lesson uses ~5 calls.
GOOGLE_AI_STUDIO_KEY=

# Neon Postgres connection string — must include sslmode=require
# Get from neon.tech project → Connection Details → "Pooled connection"
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Random ≥32-char string used to daily-salt IP hashes for rate limiting.
# Rotate periodically in prod; any value works in dev.
IP_SALT=change-me-to-a-random-32-char-string

# ── Optional ────────────────────────────────────────────────────────────

# Override the Gemma model used for all phases.
# AI Studio surfaces gemma-4-31b-it (dense, default) and
# gemma-4-26b-a4b-it (MoE, faster, slightly less reliable on long schemas).
# GEMMA_MODEL_ID=gemma-4-31b-it

# Set to your Vercel deployment URL for OG meta tags + share-link copy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel cron auth — auto-set by Vercel for cron requests; required in prod
# so /api/cron/prune can't be hit anonymously. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Optional: Sentry DSN for error tracking (not currently wired)
SENTRY_DSN=
