# TLC — environment variables
# Copy to .env.local for local dev; set in Vercel dashboard for prod.

# Gemma 4 via Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_KEY=

# Neon Postgres connection string — includes pooling param
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Random 32-char string used to hash IPs for rate limiting
# (rotate daily in prod; static in dev)
IP_SALT=change-me-to-a-random-32-char-string

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Optional: Vercel deploy URL used for CORS allowlist
NEXT_PUBLIC_APP_URL=http://localhost:3000
